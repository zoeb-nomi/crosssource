# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the generation model (default: claude-opus-4-8)
# CROSSSOURCE_MODEL=claude-opus-4-8

# v0.3
# Two-model sanity pass (run_eval.py --dataset v0.3): the OpenAI model needs this
# OPENAI_API_KEY=sk-...
# Opinion fetch (src/v03_fetch.py) — CourtListener profile -> API token
# COURTLISTENER_API_TOKEN=...
# Optional price overrides, $ per million tokens: {"model": [input, output]}
# CROSSSOURCE_PRICES={"<openai-model-id>": [<input $/MTok>, <output $/MTok>]}
